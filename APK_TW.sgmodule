#!name=APK.TW 自動簽到 V2
#!desc=完整 Cookie 擷取、自動續期、每日簽到、二次補簽驗證
#!author=howsingsong

[Script]

APK.TW Cookie 擷取 = type=http-request,pattern=^https:\/\/(?:www\.)?apk\.tw\/,script-path=https://raw.githubusercontent.com/howsingsong/apk-tw-surge/main/apk_tw_cookie.js,full-header-mode=true,timeout=10

APK.TW Cookie 更新 = type=http-response,pattern=^https:\/\/(?:www\.)?apk\.tw\/,script-path=https://raw.githubusercontent.com/howsingsong/apk-tw-surge/main/apk_tw_cookie.js,full-header-mode=true,timeout=10

APK.TW 每日自動簽到 = type=cron,cronexp="20 0 * * *",script-path=https://raw.githubusercontent.com/howsingsong/apk-tw-surge/main/apk_tw_checkin.js,wake-system=true,timeout=60

APK.TW 補簽檢查 = type=cron,cronexp="20 8 * * *",script-path=https://raw.githubusercontent.com/howsingsong/apk-tw-surge/main/apk_tw_checkin.js,argument="silent_if_signed=1",wake-system=true,timeout=60

APK.TW 登入保活 = type=cron,cronexp="10 6,18 * * *",script-path=https://raw.githubusercontent.com/howsingsong/apk-tw-surge/main/apk_tw_keepalive.js,wake-system=true,timeout=30

[MITM]
hostname = %APPEND% apk.tw, www.apk.tw
